{
  "description": "等待授权时推通知；用户发消息时取消本会话的待发提醒",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(python3 -c 'import sys,json; print(json.load(sys.stdin).get(\"message\",\"Claude 在等你\"))'); \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh\" \"$msg\" \"Claude 需要你\""
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"$(python3 -c 'import sys,json; print(json.load(sys.stdin).get(\"session_id\",\"default\"))')\"; \"${CLAUDE_PLUGIN_ROOT}/scripts/mark.sh\" \"$s\"; \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.sh\" --cancel \"$s\""
          }
        ]
      }
    ]
  }
}
