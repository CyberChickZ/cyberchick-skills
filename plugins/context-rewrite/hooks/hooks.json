{
  "description": "拦下 /context-rewrite 直接执行，结果只显示给用户，不进上下文、不调用模型",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/context-rewrite/scripts/ctxrw.py\" hook",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/context-rewrite/scripts/ctxrw.py\" hook",
            "timeout": 90
          }
        ]
      }
    ]
  }
}